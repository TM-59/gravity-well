{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "commonjs",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "moduleDetection": "force"
  },
  "include": ["web/*.js", "web/*.d.ts", "scripts/*.cjs"]
}
